  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.41.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "4.21.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vitest": "^5.0.0"
  }
