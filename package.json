{
  "name": "kitze-reusable-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "registry:build": "tsx scripts/build-registry.ts",
    "test": "vitest run",
